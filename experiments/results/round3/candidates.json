{
 "doc": "Round-3 candidates ledger (hand-written part). ledger_round3.py merges these notes with the screening numbers (results/round3/screen_summary.json) and the full-length comparisons into results/round3/candidates.json. status: idea | screened | rejected | confirmed | shipped.",
 "v6_code_changes": [
  {
   "id": "area_scaling",
   "what": "zone PI gains, request cap and setback burst scale with zone floor area / 100 m2 (areas from the metadata zone map, 4-connected rooms in raster order, verified to reproduce the simulator's room numbering on all 14 buildings)",
   "why": "v5 constants were tuned on ~100 m2 zones; building_0502's 350-470 m2 zones recovered at <1 K/h and sat below the band until noon (diagnosis of the v4/v5 time series, 2026-10-23)",
   "param": "gain_area_scaling, area_ref_m2, area_scale_min/max"
  },
  {
   "id": "physical_cap",
   "what": "request cap bounded by what the box can deliver at a flow fraction f_cap (discharge limit 308.15 K for heating, 285 K supply for cooling)",
   "why": "the 12 kW constant cap was the binding limit on large zones",
   "param": "f_cap_pre, f_cap_occ, q_cap_w"
  },
  {
   "id": "water_cap",
   "what": "heating request also bounded by the coil's water-side limit: valve fully open at the maximum loop dP (Kv 0.108) moves w_avail*(T_water - T_supply) W; at the discharge limit the net heat is coil*(T_disch_max - T)/(T_disch_max - T_supply)",
   "why": "asking for more than that raises airflow, cools the discharge air and delivers LESS heat (seen on building_0502: valve saturated, damper at 1, zone 0.8 K below band). Ten-day test on 0502/denver_1: 0.02437 -> 0.02376",
   "param": "water_cap, water_cap_frac"
  },
  {
   "id": "per_zone_start",
   "what": "optimum start per zone: each zone learns its own recovery rate (EMA of recovered K / h over its preconditioning episodes) and enters PRECONDITION at its own lead",
   "why": "one building-wide lead woke every zone with the slowest one; with heterogeneous zone sizes the fast zones were held for hours",
   "param": "per_zone_start"
  },
  {
   "id": "adaptive_floor",
   "what": "setback floor (ceiling) of a zone raised (lowered) to what its learned rate can recover within lead_max_h",
   "why": "a 400+ m2 zone cannot recover 13 K in 8 h",
   "param": "adaptive_floor"
  },
  {
   "id": "pre_latch",
   "what": "a zone that started preconditioning holds the target until 06:00 instead of flipping back to SETBACK when the air is warm",
   "why": "hypothesis: the PRECOND/SETBACK oscillation inflates the learned rate. REJECTED: ten-day test on 0502/denver_1 0.02816 vs 0.02376 without the latch; holding the air at 294.8 K for the extra hours costs more gas than the pulsed recovery (the walls lag the air by hours, so letting the air collapse and re-burst keeps the mean air temperature, hence the envelope loss, lower)",
   "param": "pre_latch (default 0)"
  }
 ],
 "ideas_not_run": {
  "night_free_cooling_precool": "run the economiser at night to pre-cool the mass in Atlanta/Denver summers (fan-only cooling at COP ~20 vs chiller 3.5); not run: night OAT-return differences in the public strips are small and Singapore/Phoenix never qualify; estimated < 2% of the public mean",
  "morning_precool_phoenix": "pre-cool to the band bottom before noon when OAT is lower and electricity is 18 c instead of 20 c; not run: the extra envelope gain from holding the colder zone offsets most of the 20% per-kWh advantage; estimated ~1%",
  "ahu_duty_cycling_occupied": "switch handlers off for short periods during occupied hours to cut the forced minimum-flow ventilation of idle zones (27% of supply air while heating); not run: comfort is ~150x the energy value of 1 K per occupied zone and the air collapses toward the wall temperature within a step when the handler stops",
  "holiday_calendar": "skip the preconditioning before US federal holidays; not possible: the observation carries hour and weekday only, no date",
  "learned_residual": "ridge/GBM correction on logged (obs -> action) pairs; not started: the rule-based changes did not plateau within the round",
  "mixed_handler_simultaneous_heat_cool": "quantified on the v5 public diag runs: 26% of running handler-steps have a cooling SAT (<= 292.5 K) together with an open reheat valve, but the chiller runs in only 6.5% of the cooling kWh during them (cold-climate mixed air is below the 292 K floor, so the coil is idle); the simultaneous heating/cooling waste is a few per cent of the cooling term at most, not pursued",
  "fcap_pre_on_public": "f_cap_pre 0.5 / 0.7 / 1.0 give identical public screens (0.00846-0.00847): the 12 kW x area cap binds first on 100 m2 zones; the flow cap only matters on the large held-out zones"
 },
